{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error"
    },
    "plugins": ["typescript", "vue", "oxc"],
    "rules": {
        "no-unused-vars": "off",
        "no-useless-catch": "off"
    },
    "env": {
        "browser": true,
        "node": true
    },
    "ignorePatterns": ["dist/**", "src/data/**"]
}
