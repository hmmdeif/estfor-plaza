{
    "name": "estfor-plaza",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm run typecheck && vite build",
        "build:scripts": "node ./scripts/copyDataFiles.mjs",
        "typecheck": "vue-tsc --noEmit",
        "lint": "oxlint src scripts vite.config.ts",
        "format": "oxfmt src scripts vite.config.ts *.json *.md",
        "preview": "vite preview"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@paintswap/estfor-definitions": "^2.0.113",
        "@reown/appkit": "^1.8.23",
        "@reown/appkit-adapter-wagmi": "^1.8.23",
        "@wagmi/core": "3.6.4",
        "ethers": "^6.17.0",
        "pinia": "^4.0.3",
        "viem": "^2.55.19",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "daisyui": "^5.7.22",
        "oxfmt": "^0.64.0",
        "oxlint": "^1.80.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.24.0"
}
